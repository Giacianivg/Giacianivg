# ============================================================
# Pousada Luz da Lua — WhatsApp Webhook Handler
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env com credenciais reais
# ============================================================

# ------------------------------------------------------------
# WhatsApp Business API (Meta Cloud API)
# Obtido em: Meta Developers Portal → WhatsApp → Phone Numbers
# ------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=<obtido_no_meta_developers_portal>
WHATSAPP_BUSINESS_ACCOUNT_ID=<obtido_no_meta_developers_portal>

# Token permanente de acesso — System User Token
# Meta Business Manager → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=<system_user_token_permanente>

# String aleatória para verificar autenticidade do webhook
# Crie com: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=<string_aleatoria_secreta>

# URL pública deste webhook (gerada após deploy no Vercel/Railway)
WEBHOOK_URL=https://<seu-dominio>.vercel.app/webhook

# ------------------------------------------------------------
# Anthropic — Claude API para a assistente virtual Luna
# console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-<sua-chave-anthropic>

# ------------------------------------------------------------
# Equipe — número WhatsApp da recepção para escalonamentos
# Formato: código do país + DDD + número (sem + nem espaços)
# Exemplo: 5519998400306
# ------------------------------------------------------------
EQUIPE_WHATSAPP_NUMBER=5519998400306

# ------------------------------------------------------------
# Configuração do servidor
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
