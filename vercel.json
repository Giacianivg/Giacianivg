{
  "version": 2,
  "regions": ["iad1"],
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/crm.js":   { "maxDuration": 30, "includeFiles": "public/**" }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/grupos",          "dest": "/grupos.html" },
    { "src": "/fds-especiais",   "dest": "/fds-especiais.html" },
    { "src": "/orcamento-grupo", "dest": "/orcamento-grupo.html" },
    { "src": "/api/(.*)", "dest": "/api/crm.js" },
    { "src": "/(.*)",     "dest": "/api/index.js" }
  ],
  "crons": [
    { "path": "/api/cron/competitor-prices", "schedule": "0 3 * * *" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
