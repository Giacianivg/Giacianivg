{
  "version": 2,
  "regions": ["iad1"],
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/crm.js":   { "maxDuration": 30, "includeFiles": "public/**" }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/crm.js" },
    { "src": "/(.*)",     "dest": "/api/index.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
